set shell := ["bash", "-euo", "pipefail", "-c"]

# The flake dev shell (nix/shell.nix, loaded by direnv through .envrc)
# pins the Go toolchain go.mod names and adds the lint stack, fonts, and
# a headless sway; a plain PATH `go` at that version works too.
go := "go"

# Where `just build` puts the binaries.
dist := "dist"

# Default — list recipes.
default:
    @just --list --unsorted

# ─────────────────────────── Build & Run ───────────────────────────

# The program interpreter the dist/ binaries request: the distro's
# loader at its standard path. purego links them dynamically, and a Go
# toolchain from Nix would otherwise name its own /nix/store loader,
# which exists only on NixOS.
fhs_interpreter := if arch() == "aarch64" { "/lib/ld-linux-aarch64.so.1" } else { "/lib64/ld-linux-x86-64.so.2" }

# Build the release binaries into dist/: pure Go (lys-ui dlopens what it
# needs through purego), stripped, asking for the standard loader; and
# the shell completions, generated by a host build so packaging never
# runs a binary made for another system's loader.
build:
    CGO_ENABLED=0 {{go}} build -trimpath -ldflags "-s -w -I {{fhs_interpreter}}" -o {{dist}}/ ./cmd/lys-shell ./cmd/lys-greeter ./cmd/lys-lock ./cmd/lys-settings
    {{go}} run ./internal/tools/distcheck {{dist}}/lys-shell {{dist}}/lys-greeter {{dist}}/lys-lock {{dist}}/lys-settings
    mkdir -p {{dist}}/completions
    {{go}} run ./cmd/lys-shell completions bash > {{dist}}/completions/completions.bash
    {{go}} run ./cmd/lys-shell completions zsh > {{dist}}/completions/_lys-shell
    {{go}} run ./cmd/lys-shell completions fish > {{dist}}/completions/lys-shell.fish

# Run the lys-shell binary. Extra args pass through: `just run config get bar.location`.
run *args:
    {{go}} run ./cmd/lys-shell {{args}}

# Run the settings app.
run-settings *args:
    {{go}} run ./cmd/lys-settings {{args}}

# Stop the packaged shell so a dev build can take over (only one instance may
# hold the dev.stubbe.lys.shell bus name), run it, then restore the service on exit.
dev-shell *args:
    #!/usr/bin/env bash
    set -uo pipefail
    was_active=$(systemctl --user is-active lys-shell.service || true)
    if [ "$was_active" = "active" ]; then systemctl --user stop lys-shell.service; fi
    trap '[ "$was_active" = "active" ] && systemctl --user start lys-shell.service' EXIT
    {{go}} run ./cmd/lys-shell shell {{args}}

# Run the greeter as a window on your current session for UI iteration: your
# user config for theming, throwaway state in /tmp. Login attempts only show an
# error unless a real greetd socket is around ($GREETD_SOCK), which is fine for
# visuals.
dev-greeter *args:
    {{go}} run ./cmd/lys-greeter --config ~/.config/lys-shell/config.yaml --state /tmp/lys-greeter-dev/last-session {{args}}

# Tail today's shell log — `just logs 200` for more backlog.
logs lines="80":
    tail -n {{lines}} -f "${XDG_STATE_HOME:-$HOME/.local/state}/lys-shell/lys-shell.$(date +%F).log"

# Remove the build output.
clean:
    rm -rf {{dist}}

# ─────────────────────────── Check ───────────────────────────

# Format every package in place (gofumpt and gci via golangci-lint).
fmt:
    golangci-lint fmt

# Lint without changing anything: formatting, vet, and golangci-lint
# (settings in .golangci.yml).
lint:
    golangci-lint fmt --diff
    {{go}} vet ./...
    golangci-lint run

# Run the test suite in a random order, so a test that leans on state an
# earlier one left behind fails instead of passing by declaration order.
test *args:
    {{go}} test -shuffle=on ./... {{args}}

# Run the test suite under the race detector. It needs cgo (a C
# toolchain), which the shipped CGO_ENABLED=0 build never does.
race:
    CGO_ENABLED=1 {{go}} test -race -shuffle=on ./...

# The committed config schema must be what the binary generates.
schema-check:
    #!/usr/bin/env bash
    set -euo pipefail
    got=$(mktemp)
    trap 'rm -f "$got"' EXIT
    {{go}} run ./cmd/lys-shell config schema --stdout | jq -S . > "$got"
    if ! diff -u schema/lys-shell-config.schema.json "$got"; then
        echo "Config schema is out of date: run \`just schema\`." >&2
        exit 1
    fi

# The shell on a live Hyprland in a NixOS VM (needs KVM): bars on every
# output and hotplug, the Hyprland modules, launcher, popups, and the
# session lock across a shell restart. Screenshots of every state land
# in ./result.
hyprland-vm:
    nix build -L .#checks.{{ arch() }}-{{ os() }}.lys-shell-hyprland-vm

# Lint, test, race, and the schema check. Run before every release.
check: lint test race schema-check

# Check the screen recorder on this machine's GPU (run it in the dev
# shell): a private headless sway renders on the first render node with
# Vulkan, the recorder records 3 s of it into MP4 and Matroska with
# audio, and the log shows the Vulkan device, the modifier the capture
# took, the codecs the device encodes, and ffprobe's reading of each
# file; every output transform and a region are recorded and checked
# upright. A GPU without an H.264 encoder says so, and why, instead.
# LYS_TEST_GPU makes it a hardware check: a run that cannot reach the
# GPU (no render node, no Vulkan driver for it, no encoder) fails
# instead of skipping.
recorder-check:
    LYS_TEST_GPU=host {{go}} test -count=1 -v -run '^(TestNoH264EncoderIsTheDefinedError|TestRecordsAnOutputOnTheGPU|TestWebcamOverlayIsEncodedIntoTheFrame|TestRecordsTransformedOutputsAndRegionsUpright)$' ./service/recorder/

# ─────────────────────────── Generated files ───────────────────────────

# Regenerate the committed config JSON schema. Its $id embeds the version,
# so the release flow rewrites it on every bump.
schema:
    {{go}} run ./cmd/lys-shell config schema --stdout | jq -S . > schema/lys-shell-config.schema.json

# Recompute nix/lys-shell.nix's vendorHash after a go.mod change (a lys-ui
# bump): the vendor derivation is fixed-output, so a stale hash reuses
# the old module set instead of reporting the new one. Needs nix.
vendor-hash:
    #!/usr/bin/env bash
    set -euo pipefail
    file=nix/lys-shell.nix
    sed -i 's|vendorHash = "sha256-[^"]*";|vendorHash = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";|' "$file"
    # The build fails by design (the fake hash); its report is the point.
    got=$( (nix build .#lys-shell --no-link 2>&1 || true) | sed -n 's/^ *got: *\(sha256-[^ ]*\).*/\1/p' | head -1)
    if [ -z "$got" ]; then echo "no hash reported" >&2; exit 1; fi
    sed -i "s|vendorHash = \"sha256-[^\"]*\";|vendorHash = \"$got\";|" "$file"
    echo "vendorHash = $got"

# Update the Go dependencies to their latest versions, then the vendor hash.
update:
    {{go}} get -u ./...
    {{go}} mod tidy
    just vendor-hash

# ─────────────────────────── Nix cache ───────────────────────────

# Build the flake package and push its closure to the self-hosted xilo
# cache (https://nix.stubbe.dev, cache `default/default`) — the same cache CI
# pushes to. Pull access is public via the flake's substituter; pushing needs
# a token, from either XILO_TOKEN or a `xilo login` profile.
#
# --url is passed explicitly because the cache is a property of this project,
# not of the machine: with no profile and no XILO_URL, xilo falls back to
# localhost:8080 and the push dies with "no server configured" after the
# build. Credentials stay the machine's business; the check below only
# refuses to start that build when there are none to be found.
cache-push:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${XILO_TOKEN:-}" ] && \
       [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/xilo/config.yaml" ]; then
        echo "Error: no push credentials — set XILO_TOKEN, or run:" >&2
        echo "  xilo login https://nix.stubbe.dev --token <tok> --cache default/default" >&2
        exit 1
    fi
    nix build .#lys-shell -L --accept-flake-config
    xilo push default/default ./result --url https://nix.stubbe.dev

# ─────────────────────────── Release ───────────────────────────

release-preview:
    #!/usr/bin/env bash
    set -euo pipefail
    CURRENT_TAG=$(git tag -l 'v*.*.*' --sort=-v:refname | head -1)
    CURRENT_TAG=${CURRENT_TAG:-v0.0.0}
    CURRENT_VERSION=${CURRENT_TAG#v}
    MAJOR=$(echo "$CURRENT_VERSION" | cut -d. -f1)
    MINOR=$(echo "$CURRENT_VERSION" | cut -d. -f2)
    PATCH=$(echo "$CURRENT_VERSION" | cut -d. -f3)
    echo "Current tag: $CURRENT_TAG"
    echo "  release-major: v$((MAJOR + 1)).0.0"
    echo "  release-minor: v${MAJOR}.$((MINOR + 1)).0"
    echo "  release-patch: v${MAJOR}.${MINOR}.$((PATCH + 1))"

# Refuse to release a commit CI has already judged broken, without waiting on
# anything: one status read, no polling. A run still in flight (or not started,
# or never, because HEAD is unpushed) is not an error — the tag pushed below
# gets its own CI run, which is the real verification. LYS_SHELL_RELEASE_NO_CI=1
# checks locally instead (offline, or CI is down).
_reject-red-ci:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${LYS_SHELL_RELEASE_NO_CI:-}" ]; then
        echo "LYS_SHELL_RELEASE_NO_CI set — running the local check instead."
        just check
        exit 0
    fi
    SHA=$(git rev-parse HEAD)
    read -r STATUS CONCLUSION <<<"$(gh run list --workflow CI --commit "$SHA" --limit 1 \
        --json status,conclusion -q '.[0] | "\(.status) \(.conclusion)"' 2>/dev/null || true)"
    case "${STATUS:-}${CONCLUSION:-}" in
        completedsuccess) echo "CI green for ${SHA:0:7}." ;;
        completed*)
            echo "Error: CI concluded '$CONCLUSION' for ${SHA:0:7} — not releasing." >&2
            echo "Fix it, or set LYS_SHELL_RELEASE_NO_CI=1 to check locally instead." >&2
            exit 1
            ;;
        *) echo "No finished CI run for ${SHA:0:7} yet — releasing anyway; the tag's run verifies it." ;;
    esac

_release-checks:
    #!/usr/bin/env bash
    set -euo pipefail
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    DEFAULT_BRANCH=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
    if [ -z "${DEFAULT_BRANCH:-}" ]; then
        DEFAULT_BRANCH=$(git remote show origin 2>/dev/null | awk '/HEAD branch/ {print $NF}' || echo master)
    fi
    if [ "$BRANCH" != "$DEFAULT_BRANCH" ]; then
        echo "Error: not on default branch '$DEFAULT_BRANCH' (currently '$BRANCH')." >&2
        exit 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
        echo "Error: working tree is dirty. Commit (or stash) it, so what gets tagged is what CI builds." >&2
        exit 1
    fi
    just _reject-red-ci

_release bump:
    #!/usr/bin/env bash
    set -euo pipefail
    just _release-checks
    CURRENT_TAG=$(git tag -l 'v*.*.*' --sort=-v:refname | head -1)
    CURRENT_TAG=${CURRENT_TAG:-v0.0.0}
    CURRENT_VERSION=${CURRENT_TAG#v}
    MAJOR=$(echo "$CURRENT_VERSION" | cut -d. -f1)
    MINOR=$(echo "$CURRENT_VERSION" | cut -d. -f2)
    PATCH=$(echo "$CURRENT_VERSION" | cut -d. -f3)
    case "{{bump}}" in
        major) NEW="$((MAJOR + 1)).0.0" ;;
        minor) NEW="${MAJOR}.$((MINOR + 1)).0" ;;
        patch) NEW="${MAJOR}.${MINOR}.$((PATCH + 1))" ;;
        *) echo "unknown bump kind: {{bump}}"; exit 1 ;;
    esac
    # The release workflow refuses a tag that does not match
    # internal/version, so the bump lands first.
    sed -i -E 's|^const Version = "[^"]*"$|const Version = "'"$NEW"'"|' internal/version/version.go
    grep -qx "const Version = \"${NEW}\"" internal/version/version.go || {
        echo "Error: internal/version/version.go does not read ${NEW} after the bump." >&2
        exit 1
    }
    # The schema $id embeds the version; regenerate it from the bumped binary.
    just schema
    grep -q "\"\$id\": \"lys-shell-config-${NEW}\"" schema/lys-shell-config.schema.json || {
        echo "Error: schema \$id is not lys-shell-config-${NEW} after the bump." >&2
        exit 1
    }
    git add internal/version/version.go schema/lys-shell-config.schema.json
    git commit -m "chore: release v${NEW}"
    git tag -a "v${NEW}" -m "v${NEW}"
    git push origin HEAD
    git push origin "v${NEW}"
    echo
    echo "Tagged and pushed v${NEW}. The build, archives and cache push run on CI."
    echo "  status:  gh run list --workflow Release --limit 1"
    echo "  actions: https://github.com/stubbedev/lys-shell/actions"

release-patch: (_release "patch")
release-minor: (_release "minor")
release-major: (_release "major")
