
using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'wayle' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'wayle'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'wayle' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('audio', 'audio', [CompletionResultType]::ParameterValue, 'Audio control commands')
            [CompletionResult]::new('config', 'config', [CompletionResultType]::ParameterValue, 'Configuration management commands')
            [CompletionResult]::new('icons', 'icons', [CompletionResultType]::ParameterValue, 'Icon management commands')
            [CompletionResult]::new('media', 'media', [CompletionResultType]::ParameterValue, 'Media player control commands')
            [CompletionResult]::new('notify', 'notify', [CompletionResultType]::ParameterValue, 'Notification control commands')
            [CompletionResult]::new('panel', 'panel', [CompletionResultType]::ParameterValue, 'Panel management commands')
            [CompletionResult]::new('power', 'power', [CompletionResultType]::ParameterValue, 'Power profile commands')
            [CompletionResult]::new('systray', 'systray', [CompletionResultType]::ParameterValue, 'System tray commands')
            [CompletionResult]::new('wallpaper', 'wallpaper', [CompletionResultType]::ParameterValue, 'Wallpaper control commands')
            [CompletionResult]::new('idle', 'idle', [CompletionResultType]::ParameterValue, 'Idle inhibit control commands')
            [CompletionResult]::new('launcher', 'launcher', [CompletionResultType]::ParameterValue, 'Application launcher / dmenu with rofi-compatible flags')
            [CompletionResult]::new('lock', 'lock', [CompletionResultType]::ParameterValue, 'Lock the session via Wayle''s lock screen')
            [CompletionResult]::new('vpn', 'vpn', [CompletionResultType]::ParameterValue, 'VPN commands')
            [CompletionResult]::new('recorder', 'recorder', [CompletionResultType]::ParameterValue, 'Screen recorder control commands')
            [CompletionResult]::new('screenshot', 'screenshot', [CompletionResultType]::ParameterValue, 'Screenshot capture commands')
            [CompletionResult]::new('widget', 'widget', [CompletionResultType]::ParameterValue, 'Widget control commands')
            [CompletionResult]::new('toast', 'toast', [CompletionResultType]::ParameterValue, 'Show a custom on-screen toast')
            [CompletionResult]::new('portal', 'portal', [CompletionResultType]::ParameterValue, 'xdg-desktop-portal backend, screencast picker stub, and dialog previewer')
            [CompletionResult]::new('shell', 'shell', [CompletionResultType]::ParameterValue, 'Run the desktop shell in the foreground')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completions')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'wayle;audio' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('output-volume', 'output-volume', [CompletionResultType]::ParameterValue, 'Get or set output volume level')
            [CompletionResult]::new('output-mute', 'output-mute', [CompletionResultType]::ParameterValue, 'Toggle output mute state')
            [CompletionResult]::new('input-volume', 'input-volume', [CompletionResultType]::ParameterValue, 'Get or set input volume level')
            [CompletionResult]::new('input-mute', 'input-mute', [CompletionResultType]::ParameterValue, 'Toggle input mute state')
            [CompletionResult]::new('sinks', 'sinks', [CompletionResultType]::ParameterValue, 'List available audio sinks (outputs)')
            [CompletionResult]::new('sources', 'sources', [CompletionResultType]::ParameterValue, 'List available audio sources (inputs)')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Show current audio status')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
