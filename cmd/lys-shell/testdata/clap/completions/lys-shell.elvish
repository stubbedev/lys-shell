
use builtin;
use str;

set edit:completion:arg-completer[lys-shell] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'lys-shell'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'lys-shell'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand audio 'Audio control commands'
            cand config 'Configuration management commands'
            cand icons 'Icon management commands'
            cand media 'Media player control commands'
            cand notify 'Notification control commands'
            cand panel 'Panel management commands'
            cand power 'Power profile commands'
            cand systray 'System tray commands'
            cand wallpaper 'Wallpaper control commands'
            cand idle 'Idle inhibit control commands'
            cand launcher 'Application launcher / dmenu with rofi-compatible flags'
            cand lock 'Lock the session via lys-shell''s lock screen'
            cand vpn 'VPN commands'
            cand recorder 'Screen recorder control commands'
            cand screenshot 'Screenshot capture commands'
            cand widget 'Widget control commands'
            cand toast 'Show a custom on-screen toast'
            cand portal 'xdg-desktop-portal backend, screencast picker stub, and dialog previewer'
            cand shell 'Run the desktop shell in the foreground'
            cand completions 'Generate shell completions'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'lys-shell;audio'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand output-volume 'Get or set output volume level'
            cand output-mute 'Toggle output mute state'
            cand input-volume 'Get or set input volume level'
            cand input-mute 'Toggle input mute state'
            cand sinks 'List available audio sinks (outputs)'
            cand sources 'List available audio sources (inputs)'
            cand status 'Show current audio status'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'lys-shell;audio;output-volume'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;output-mute'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;input-volume'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;input-mute'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;sinks'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;sources'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;status'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'lys-shell;audio;help'= {
            cand output-volume 'Get or set output volume level'
            cand output-mute 'Toggle output mute state'
            cand input-volume 'Get or set input volume level'
            cand input-mute 'Toggle input mute state'
            cand sinks 'List available audio sinks (outputs)'
            cand sources 'List available audio sources (inputs)'
            cand status 'Show current audio status'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'lys-shell;audio;help;output-volume'= {
        }
        &'lys-shell;audio;help;output-mute'= {
        }
        &'lys-shell;audio;help;input-volume'= {
        }
        &'lys-shell;audio;help;input-mute'= {
        }
        &'lys-shell;audio;help;sinks'= {
