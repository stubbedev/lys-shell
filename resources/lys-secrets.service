[Unit]
Description=lys-secrets Secret Service provider
# The provider of org.freedesktop.secrets; it stays off (and exits) when
# another provider, such as gnome-keyring, already owns the name.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/lys-secrets
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=graphical-session.target
