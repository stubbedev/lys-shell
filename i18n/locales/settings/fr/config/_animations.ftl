settings-animations-enabled = Activé
    .description = Animer l'entrée et la sortie de l'OSD, des toasts et des notifications, et fondre les changements d'icônes
settings-animations-duration = Durée
    .description = Durée de l'animation en millisecondes
settings-animations-transition = Transition
    .description = Style d'entrée et de sortie de l'OSD, des toasts et des cartes de notification
settings-animations-enter = Transition d'entrée
    .description = Transition utilisée à l'apparition des surfaces. Si elle n'est pas définie, la transition générale s'applique
settings-animations-exit = Transition de sortie
    .description = Transition utilisée à la disparition des surfaces. Si elle n'est pas définie, la transition générale s'applique
settings-animations-enter-duration = Durée d'entrée
    .description = Durée de l'animation d'entrée en millisecondes. Si elle n'est pas définie, la durée générale s'applique
settings-animations-exit-duration = Durée de sortie
    .description = Durée de l'animation de sortie en millisecondes. Si elle n'est pas définie, la durée générale s'applique
settings-animations-interaction-duration = Durée des interactions
    .description = Durée en ms du survol et des changements de page dans les menus déroulants. Désactiver les animations les supprime
settings-animations-ui-duration = Durée de l'interface
    .description = Durée de base en ms des micro-transitions générales de l'interface (survol, focus, fondus de couleur)
settings-animations-reduced-motion = Mouvements réduits
    .description = Remplacer les mouvements par des fondus ici et dans les applications : rien ne glisse, ne balance ni ne rebondit, et les indicateurs en boucle s'arrêtent. Sous lys-wm, ceci n'a aucun effet : définissez animations.reduced_motion dans sa configuration
settings-animations-indicators = Indicateurs
    .description = Faire tourner les indicateurs d'état en boucle : roues d'attente, animations de balayage, pulsation d'enregistrement, clignotement de l'horloge
settings-animations-notifications = Notifications
    .description = Animation propre aux cartes de notification
settings-animations-osd = OSD
    .description = Animation propre à l'OSD (volume, luminosité, bascule)
settings-animations-dropdown = Menu déroulant
    .description = Animation propre aux menus déroulants des modules de la barre
settings-animations-share-picker = Animation
    .description = Animation propre au sélecteur de partage d'écran
settings-animations-wallpaper = Fond d'écran
    .description = Animation propre au fondu du fond d'écran
settings-animations-power = Menu d'alimentation
    .description = Animation propre au menu d'alimentation
settings-animations-dialog = Boîte de dialogue du portail
    .description = Animation propre aux boîtes de dialogue du portail (demandes d'accès, de compte, de choix d'application et d'installation de lanceur)
settings-animations-file-chooser = Sélecteur de fichiers du portail
    .description = Animation propre au sélecteur de fichiers du portail
settings-animations-print = Impression du portail
    .description = Animation propre à la surface d'impression du portail
settings-animations-lock = Écran de verrouillage
    .description = Animation propre à l'apparition de l'écran de verrouillage
enum-animation-type-none = Aucune
enum-animation-type-fade = Fondu
enum-animation-type-slide-up = Glissement vers le haut
enum-animation-type-slide-down = Glissement vers le bas
enum-animation-type-slide-left = Glissement vers la gauche
enum-animation-type-slide-right = Glissement vers la droite
enum-animation-type-swing-up = Balancement vers le haut
enum-animation-type-swing-down = Balancement vers le bas
enum-animation-type-swing-left = Balancement vers la gauche
enum-animation-type-swing-right = Balancement vers la droite
enum-animation-type-bounce = Rebond
enum-animation-type-genie = Génie
enum-animation-type-zoom = Zoom
enum-animation-type-rotate = Rotation
enum-animation-type-flip = Retournement
