### lys-shell Configuration - Privacy Module

## Privacy Module Configuration

settings-modules-privacy-icon = Microphone Icon
    .description = Icon shown while an app records a microphone

settings-modules-privacy-camera-icon = Camera Icon
    .description = Icon shown while an app holds a camera open

settings-modules-privacy-screen-icon = Screen Icon
    .description = Icon shown while an app shares the screen

settings-modules-privacy-border-show = Show Border
    .description = Display border around button

settings-modules-privacy-border-color = Border Color
    .description = Border color token

settings-modules-privacy-icon-show = Show Icon
    .description = Display module icon

settings-modules-privacy-icon-color = Icon Color
    .description = Icon foreground color

settings-modules-privacy-icon-bg-color = Icon Background
    .description = Icon container background color

settings-modules-privacy-label-show = Show Label
    .description = Display the number of apps beside the icons

settings-modules-privacy-label-color = Label Color
    .description = Label text color

settings-modules-privacy-label-max-length = Label Max Length
    .description = Max characters before truncation

settings-modules-privacy-button-bg-color = Button Background
    .description = Button background color

settings-modules-privacy-left-click = Left Click
    .description = Shell command on left click

settings-modules-privacy-right-click = Right Click
    .description = Shell command on right click

settings-modules-privacy-middle-click = Middle Click
    .description = Shell command on middle click

settings-modules-privacy-scroll-up = Scroll Up
    .description = Shell command on scroll up

settings-modules-privacy-scroll-down = Scroll Down
    .description = Shell command on scroll down
