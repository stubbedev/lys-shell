### lys-shell Configuration - Background Apps Module

## Background Apps Module Configuration

settings-modules-background-apps-icon = Icon
    .description = Bar button icon

settings-modules-background-apps-border-show = Show Border
    .description = Display border around button

settings-modules-background-apps-border-color = Border Color
    .description = Border color token

settings-modules-background-apps-icon-show = Show Icon
    .description = Display module icon

settings-modules-background-apps-icon-color = Icon Color
    .description = Icon foreground color

settings-modules-background-apps-icon-bg-color = Icon Background
    .description = Icon container background color

settings-modules-background-apps-label-show = Show Label
    .description = Display the number of background apps beside the icon

settings-modules-background-apps-label-color = Label Color
    .description = Label text color

settings-modules-background-apps-label-max-length = Label Max Length
    .description = Max characters before truncation

settings-modules-background-apps-button-bg-color = Button Background
    .description = Button background color

settings-modules-background-apps-left-click = Left Click
    .description = Shell command on left click

settings-modules-background-apps-right-click = Right Click
    .description = Shell command on right click

settings-modules-background-apps-middle-click = Middle Click
    .description = Shell command on middle click

settings-modules-background-apps-scroll-up = Scroll Up
    .description = Shell command on scroll up

settings-modules-background-apps-scroll-down = Scroll Down
    .description = Shell command on scroll down
