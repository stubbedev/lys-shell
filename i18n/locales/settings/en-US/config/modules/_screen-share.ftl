### lys-shell Configuration - Screen Share Module

## Screen Share Module Configuration

settings-modules-screen-share-icon = Icon
    .description = Bar button icon

settings-modules-screen-share-border-show = Show Border
    .description = Display border around button

settings-modules-screen-share-border-color = Border Color
    .description = Border color token

settings-modules-screen-share-icon-show = Show Icon
    .description = Display module icon

settings-modules-screen-share-tooltip = Show Tooltip
    .description = Show the module's state in a tooltip on hover

settings-modules-screen-share-icon-color = Icon Color
    .description = Icon foreground color

settings-modules-screen-share-icon-bg-color = Icon Background
    .description = Icon container background color

settings-modules-screen-share-label-show = Show Label
    .description = Display the number of shares beside the icon

settings-modules-screen-share-label-color = Label Color
    .description = Label text color

settings-modules-screen-share-label-max-length = Label Max Length
    .description = Max characters before truncation

settings-modules-screen-share-button-bg-color = Button Background
    .description = Button background color

settings-modules-screen-share-left-click = Left Click
    .description = Shell command on left click

settings-modules-screen-share-right-click = Right Click
    .description = Shell command on right click

settings-modules-screen-share-middle-click = Middle Click
    .description = Shell command on middle click

settings-modules-screen-share-scroll-up = Scroll Up
    .description = Shell command on scroll up

settings-modules-screen-share-scroll-down = Scroll Down
    .description = Shell command on scroll down
